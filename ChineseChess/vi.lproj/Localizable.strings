/* Onboarding */
"onboarding.page1.title" = "Hai Đạo Quân, Một Dòng Sông";
"onboarding.page1.body" = "Cờ Tướng là trò chơi chiến thuật Trung Hoa hơn 2.000 năm tuổi dành cho hai người chơi, diễn ra trên bàn cờ 9×10 được chia đôi bởi một dòng sông. Bắt được Tướng của đối phương để giành chiến thắng.";
"onboarding.page2.title" = "Cung Của Tướng";
"onboarding.page2.body" = "Mỗi bên có một cung 3×3. Tướng và Sĩ không bao giờ được rời khỏi cung — Tướng cũng không được đối mặt trực tiếp với Tướng đối phương trên cùng một cột trống.";
"onboarding.page3.title" = "Bảy Loại Quân Cờ";
"onboarding.page3.body" = "Xe di chuyển như quân xe trong cờ vua. Pháo di chuyển tương tự nhưng chỉ ăn quân khi nhảy qua đúng một quân cờ. Mã di chuyển theo hình chữ L và có thể bị cản. Tượng không được qua sông.";
"onboarding.page4.title" = "Bắt Được Tướng";
"onboarding.page4.body" = "Chiếu bí Tướng đối phương để giành chiến thắng — dồn Tướng vào thế không còn nước đi hợp lệ nào. Cảnh báo màu đỏ \"CHIẾU\" sẽ báo cho bạn biết khi Tướng đang bị đe dọa trực tiếp.";
"onboarding.next" = "Tiếp Theo";
"onboarding.start" = "Bắt Đầu Chơi";
