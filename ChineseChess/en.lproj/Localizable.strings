/* Onboarding */
"onboarding.page1.title" = "Two Armies, One River";
"onboarding.page1.body" = "Xiangqi is a 2,000-year-old Chinese strategy game for two players, played on a 9×10 grid split by a river. Capture the opposing General to win.";
"onboarding.page2.title" = "The General's Palace";
"onboarding.page2.body" = "Each side has a 3×3 palace. The General and Advisors can never leave it — the General also can't face the enemy General down an open file.";
"onboarding.page3.title" = "Seven Kinds of Pieces";
"onboarding.page3.body" = "Chariots move like a rook. Cannons move the same way but capture only by jumping exactly one piece. Horses move in an L-shape and can be blocked. Elephants can't cross the river.";
"onboarding.page4.title" = "Capture the General";
"onboarding.page4.body" = "Checkmate the opposing General to win — trap it with no legal move left. A red \"CHECK\" warning tells you when a General is under direct threat.";
"onboarding.next" = "Next";
"onboarding.start" = "Start Playing";
