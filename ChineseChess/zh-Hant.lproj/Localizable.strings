/* Onboarding */
"onboarding.page1.title" = "兩軍對壘，一河相隔";
"onboarding.page1.body" = "象棋是一款有兩千年歷史的中國策略遊戲，雙方在被楚河漢界分隔的 9×10 棋盤上對戰。吃掉對方的將（帥）即可獲勝。";
"onboarding.page2.title" = "將帥的九宮";
"onboarding.page2.body" = "雙方各有一個 3×3 的九宮，將（帥）與士只能在九宮內活動 — 雙方的將帥也不能在同一直線上直接對望，中間必須有其他棋子阻隔。";
"onboarding.page3.title" = "七種棋子";
"onboarding.page3.body" = "車（俥）走法如直線；炮（砲）走法相同，但吃子時必須隔一個棋子；馬（傌）走「日」字形，可被蹩馬腳；象（相）不能過河。";
"onboarding.page4.title" = "將死取勝";
"onboarding.page4.body" = "將死對方的將（帥）即可獲勝 — 讓對方無棋可走。當將帥受到直接威脅時，畫面會顯示紅色「將軍」提示。";
"onboarding.next" = "下一步";
"onboarding.start" = "開始遊戲";
